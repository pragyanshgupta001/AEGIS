# ------------------------------------------------------------------
# AEGIS configuration. Copy this file to ".env" and fill in your key.
# Never commit your real .env file.
# ------------------------------------------------------------------

# Which API style to use. One provider at a time:
#   openai_compatible -> OpenAI, Groq, OpenRouter, Google Gemini (OpenAI endpoint),
#                        or a local Ollama server
#   anthropic         -> Anthropic Claude Messages API
LLM_PROVIDER=openai_compatible

# Your API key (not needed for a local Ollama server - leave any text).
LLM_API_KEY=

# Base URL of the API.
#   OpenAI:     https://api.openai.com/v1
#   Groq:       https://api.groq.com/openai/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:     http://localhost:11434/v1
#   Anthropic:  https://api.anthropic.com
LLM_BASE_URL=https://api.openai.com/v1

# Model name exactly as the provider names it, e.g. gpt-4o-mini,
# llama-3.3-70b-versatile (Groq), gemini-2.0-flash, claude-sonnet-4-5, llama3.1 (Ollama)
LLM_MODEL=gpt-4o-mini

# Request timeout in seconds, sampling temperature, maximum output tokens.
LLM_TIMEOUT_SECONDS=90
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2500

# Ask the provider for strict JSON output (set false if your provider rejects it).
LLM_JSON_MODE=true

# Optional: price in USD per 1 million tokens. Leave EMPTY unless you have
# checked the provider's current pricing page - AEGIS shows an estimated cost
# only when both values are set.
LLM_PRICE_INPUT_PER_1M=
LLM_PRICE_OUTPUT_PER_1M=

# Investigation settings
AEGIS_DB_PATH=data/aegis.db
# How far before the incident start to look for deployment/config changes.
AEGIS_CHANGE_LOOKBACK_MINUTES=60
# Extra minutes of context around the incident window for logs/metrics/traces.
AEGIS_CONTEXT_MINUTES=10
